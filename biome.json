{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!lib/index/*.json", "!tests/fixtures", "!tests/golden", "!data", "!components/ui"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 130 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": { "rules": { "preset": "recommended" } },
  "overrides": [{ "includes": ["tests/**"], "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } } }],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
