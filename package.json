{
  "name": "arkham-ai",
  "version": "0.1.0",
  "description": "A chat assistant for two Arkham Horror: The Card Game players: rules, cards, decks and partners, answered from ArkhamDB and the Rules Reference.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alon-pilosoph/arkham-ai.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run db:migrate && next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "eval": "tsx evals/run.ts",
    "data:crawl": "tsx pipeline/crawl.ts",
    "data:index": "tsx pipeline/build-index.ts",
    "data:sheet": "tsx pipeline/label-sheet.ts",
    "data:rules": "tsx pipeline/rules.ts",
    "data:faq": "tsx pipeline/faq.ts",
    "data:collection": "tsx pipeline/collection.ts",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/openai": "4.0.102",
    "@ai-sdk/react": "4.0.157",
    "@assistant-ui/ai-sdk": "0.0.15",
    "@assistant-ui/react": "0.15.31",
    "@assistant-ui/react-markdown": "0.14.24",
    "@base-ui/react": "1.9.0",
    "@electric-sql/pglite": "0.5.12",
    "@neondatabase/serverless": "1.2.0",
    "ai": "7.0.153",
    "assistant-stream": "0.3.54",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "6.35.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "domhandler": "5.0.3",
    "drizzle-kit": "0.31.11",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.14",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
