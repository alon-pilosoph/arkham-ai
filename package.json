{
  "name": "arkham-ai",
  "version": "0.1.0",
  "description": "A chat assistant for two Arkham Horror: The Card Game players: rules, cards, decks and partners, answered from ArkhamDB and the Rules Reference.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alon-pilosoph/arkham-ai.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "eval": "tsx evals/run.ts",
    "data:crawl": "tsx pipeline/crawl.ts",
    "data:index": "tsx pipeline/build-index.ts",
    "data:sheet": "tsx pipeline/label-sheet.ts",
    "data:rules": "tsx pipeline/rules.ts",
    "data:faq": "tsx pipeline/faq.ts",
    "data:collection": "tsx pipeline/collection.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.50",
    "@ai-sdk/openai": "4.0.62",
    "@assistant-ui/ai-sdk": "0.0.4",
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-markdown": "0.14.14",
    "@base-ui/react": "1.8.0",
    "ai": "7.0.94",
    "assistant-cloud": "0.1.43",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.12",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@assistant-ui/next": "0.0.19",
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "cheerio": "1.2.0",
    "domhandler": "5.0.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
