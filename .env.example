# One of these. The app uses whichever is set; ARKHAM_MODEL overrides the choice.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional, "provider:model". Defaults: anthropic:claude-opus-5-5, openai:gpt-6-sol.
# mock:local runs with no key: a scripted stand-in that calls one tool per question.
# ARKHAM_MODEL=mock:local

# Optional: an Assistant Cloud project URL (cloud.assistant-ui.com, free for up to 200
# monthly users) to keep threads across reloads, with generated titles. Chats are then
# stored by assistant-ui. Without it, threads live in memory.
# NEXT_PUBLIC_ASSISTANT_BASE_URL=
